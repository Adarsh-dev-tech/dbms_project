# Local SQLite database (relative to prisma/schema/schema.prisma -> prisma/dev.db)
DATABASE_URL="file:../dev.db"

# Backend server port
PORT=3003

# JWT signing secret (change in production)
JWT_SECRET="exhibition-app-local-jwt-secret-change-me"
JWT_EXPIRES_IN="7d"

# Frontend URL for CORS
FRONTEND_URL="http://localhost:5173"

# Optional SMTP configuration for emailing OTPs / Excel reports
EMAIL_USER=""
EMAIL_PASS=""
